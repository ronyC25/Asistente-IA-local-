# Copia este archivo a ".env" y completa los valores.

# Modelo (opcional, sobreescribe config/settings.yaml)
ASSISTANT_MODEL=qwen3:8b

# Telegram
# 1) Crea un bot con @BotFather y pega el token aqui.
# 2) Envia un mensaje a tu bot y ejecuta:  python -m src.tools.messaging
#    para descubrir tu TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (IMAP para leer / SMTP para enviar)
EMAIL_ADDRESS=
EMAIL_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
SMTP_HOST=
SMTP_PORT=587
